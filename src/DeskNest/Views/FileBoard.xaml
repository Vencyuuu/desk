<UserControl x:Class="DeskNest.Views.FileBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="4,0,4,8">
            <TextBox x:Name="SearchBox" Height="28" Padding="27,5,28,5" Tag="搜索文件名…"
                     AutomationProperties.Name="搜索卡片内文件名" TextChanged="OnSearchChanged"
                     PreviewKeyDown="OnSearchKeyDown" />
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="9,0,0,0"
                       Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"
                       IsHitTestVisible="False" />
            <Button Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,2,0"
                    ToolTip="清除搜索" AutomationProperties.Name="清除搜索" Click="OnClearSearch">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                        <Setter Property="Width" Value="24" />
                        <Setter Property="Height" Value="24" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <ListBox x:Name="Files" Grid.Row="1" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionMode="Extended" MouseDoubleClick="OnDoubleClick"
                 PreviewMouseRightButtonDown="OnRightClick" PreviewKeyDown="OnKeyDown"
                 PreviewMouseLeftButtonDown="OnMouseDown" PreviewMouseMove="OnMouseMove">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="76" Margin="2,7" ToolTip="{Binding Entry.Path}">
                        <Grid Width="40" Height="40">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryBrush}" />
                            <Image Source="{Binding Icon}" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Text="{Binding Entry.Name}" TextAlignment="Center" FontSize="11"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="32" Margin="0,8,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsHitTestVisible="False" Margin="12">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                       Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Text="把文件拖到这里" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,16,0,6" />
            <TextBlock x:Name="EmptyDescription" Text="文件会移动到此分区，原位置不再保留"
                       FontSize="11" Foreground="{DynamicResource SecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource SelectionBrush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2" CornerRadius="8" />
    </Grid>
</UserControl>
